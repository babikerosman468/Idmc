
<%- include("../partials/head") %>

<h1>Add Researcher</h1>

<form method="POST" action="/researchers/add">

<p>

<input
type="text"
name="fullname"
placeholder="Full Name"
required>

</p>

<p>

<input
type="text"
name="institution"
placeholder="Institution">

</p>

<p>

<input
type="text"
name="department"
placeholder="Department">

</p>

<p>

<input
type="email"
name="email"
placeholder="Email">

</p>

<p>

<input
type="text"
name="phone"
placeholder="Phone">

</p>

<p>

<input
type="text"
name="orcid"
placeholder="ORCID">

</p>

<p>

<input
type="text"
name="speciality"
placeholder="Speciality">

</p>

<p>

<input
type="text"
name="country"
placeholder="Country">

</p>

<p>

<textarea
name="biography"
rows="6"
cols="60"
placeholder="Biography"></textarea>

</p>

<p>

<button type="submit">

Save Researcher

</button>

</p>

</form>

