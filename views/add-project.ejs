<%- include("partials/head") %>

<%- include("partials/header") %>

<%- include("partials/navbar") %>


<main>

<h2>Add Research Project</h2>


<form method="POST" action="/projects/save" onsubmit="this.querySelector('button[type=submit]').disabled=true; this.querySelector('button[type=submit]').textContent='Saving...';">


<p>
Title:
</p>

<input 
type="text"
name="title"
required>


<p>
Description:
</p>

<textarea
name="description"
required></textarea>


<p>
Year:
</p>

<input
type="number"
name="year"
value="2026">


<p>

<button type="submit">
Save Project
</button>

</p>


</form>


</main>


<%- include("partials/footer") %>
