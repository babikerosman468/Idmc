<%- include("partials/head") %>

<div class="content">

  <!-- Visitor Navigation -->
  <div class="topbar">
    <nav>
      <a href="/">Home</a>
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/publications">Publications</a>
      <a href="/research">Research</a>
      <a href="/diseases">Diseases</a>
      <a href="/search">Search</a>
      <a href="/about">About</a>
      <a href="/login">Admin Login</a>
      <form action="/logout" method="POST" style="display:inline; margin-left:10px;">
  <button type="submit">Logout</button>
</form>
    </nav>
  </div>

  <!-- Dashboard Heading -->
  <h1>IDMC Research Intelligence Dashboard</h1>

  <p>
    Welcome to the Infectious Disease Modelling Center research portal.
    Explore research projects, publications, researchers, and disease
    information through the public dashboard.
  </p>

  <!-- Summary Statistics -->
  <div class="cards">

    <div class="card">
      <h3>Projects</h3>
      <h1><%= stats.projects %></h1>
      <a href="/projects">Browse Projects</a>
    </div>

    <div class="card">
      <h3>Publications</h3>
      <h1><%= stats.publications %></h1>
      <a href="/publications">Browse Publications</a>
    </div>

    <div class="card">
      <h3>Researchers</h3>
      <h1><%= stats.researchers %></h1>
    </div>

    <div class="card">
      <h3>Diseases</h3>
      <h1><%= stats.diseases %></h1>
      <a href="/diseases">Explore Diseases</a>
    </div>

  </div>

  <!-- Research Summary Chart -->
  <div class="panel">

    <h2>Research Overview</h2>

<div class="panel">

  <h3>IDMC: A Scientific Digital Ecosystem</h3>

  <p>
    The Infectious Disease Modelling Center (IDMC) is evolving from a
    Node.js web application into a comprehensive scientific digital
    ecosystem supporting infectious disease modelling, artificial
    intelligence, genomics, bioinformatics, pharmacogenomics, One Health,
    digital health and advanced research collaboration.
  </p>

  <h3>Scientific Ecosystem — Version 15 and Beyond</h3>

  <p>
    Version 15 and beyond expands IDMC into a multidisciplinary
    scientific platform.
  </p>

  <ul>
    <li>AI-assisted Disease Modelling</li>
    <li>Bioinformatics</li>
    <li>Genomics</li>
    <li>Pharmacogenomics</li>
    <li>One Health</li>
    <li>Digital Health</li>
    <li>Precision Public Health</li>
    <li>Infectious Disease Surveillance</li>
    <li>Research Collaboration</li>
    <li>Scientific Data Repositories</li>
    <li>Training and e-Learning</li>
    <li>Decision Support Systems</li>
  </ul>

  <h3> Long-Term Vision</h3>

  <p>
    IDMC aims to become an integrated African digital research
    infrastructure capable of supporting:
  </p>

  <ul>
    <li>Africa CDC initiatives</li>
    <li>Horizon Europe projects</li>
    <li>EDCTP collaborations</li>
    <li>WHO collaborating centres</li>
    <li>Universities</li>
    <li>Research institutes</li>
    <li>National public health laboratories</li>
    <li>One Health networks</li>
    <li>Genomics and AI innovation hubs</li>
  </ul>

</div>

    <div style="height:350px; position:relative;">
      <canvas id="summaryChart"></canvas>
    </div>

  </div>

  <!-- Recent Activity -->
  <div class="panel">

    <h2>Recent Activity</h2>

    <ul>
      <li>
        Latest Project:
        <strong><%= stats.latestProject %></strong>
      </li>

      <li>
        Latest Publication:
        <strong><%= stats.latestPublication %></strong>
      </li>

      <li>
        Latest Researcher:
