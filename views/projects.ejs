<%- include("partials/head") %>

<%- include("partials/header") %>

<%- include("partials/navbar") %>


<main>

<h2>Research Projects</h2>

<p>
<a href="/projects/add">
Add New Project
</a>
</p>


<% if (projects.length === 0) { %>

<p>No projects available.</p>


<% } else { %>

<ul>

<% projects.forEach(project => { %>

<li>

<h3>
<%= project.title %>
</h3>

<p>
<%= project.description %>
</p>

<p>
Year: <%= project.year %>
</p>

</li>

<% }) %>

</ul>

<% } %>


</main>


<%- include("partials/footer") %>
