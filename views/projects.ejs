<%- include("partials/head") %>
<%- include("partials/header") %>
<%- include("partials/navbar") %>

<main><h2>Research Projects</h2><% if (currentUser && currentUser.role === "admin") { %>

<p>
<a href="/projects/add">Add New Project</a>
</p>
<% } %><% if (projects.length === 0) { %>

<p>No projects available.</p><% } else { %>

<ul><% projects.forEach(project => { %>

<li><h3><%= project.title %></h3><p><%= project.description %></p><p>Year: <%= project.year %></p><% if (currentUser && currentUser.role === "admin") { %>

<p>
<a href="/projects/edit/<%= project.id %>">Edit</a>
</p><form action="/projects/delete/<%= project.id %>" method="POST"
      onsubmit="return confirm('Delete this project?');">
<button type="submit">Delete</button>
</form><% } %>

</li><% }) %>

</ul><% } %>

<p><a href="/admin">Back to Administrator Dashboard</a></p></main><%- include("partials/footer") %>
