/* ======================================================
   Research Projects
====================================================== */


app.get("/projects", (req, res) => {


    const result = database.exec(
        "SELECT * FROM projects ORDER BY year DESC"
    );


    let projects = [];


    if (result.length > 0) {

        const rows = result[0].values;

        const columns = result[0].columns;


        projects = rows.map(row => {

            let obj = {};

            columns.forEach((col, i) => {

                obj[col] = row[i];

            });

            return obj;

        });

    }


    res.render(
        "projects",
        {
            projects
        }
    );


});



app.get("/projects/add", (req, res) => {

    res.render("add-project");

});



app.post("/projects/save", (req, res) => {


    const {
        title,
        description,
        year
    } = req.body;


    database.run(
`
INSERT INTO projects
(title, description, year)

VALUES (?, ?, ?)

`,
[
title,
description,
year
]
);


    saveDatabase();


    res.redirect("/projects");


});





/* ======================================================
   Publications Module
====================================================== */


app.get("/publications", (req, res) => {


    const result = database.exec(
        "SELECT * FROM publications ORDER BY year DESC"
    );


    let publications = [];


    if (result.length > 0) {


        const rows = result[0].values;

        const columns = result[0].columns;


        publications = rows.map(row => {


            let obj = {};


            columns.forEach((col, i) => {

                obj[col] = row[i];

            });


            return obj;


        });


    }


    res.render(
        "publications",
        {
            publications
        }
    );


});




app.get("/publications/add", (req, res) => {


    res.render("add-publication");


});




app.post("/publications/save", (req, res) => {


    const {
        title,
        authors,
        year

    } = req.body;



    database.run(

`
INSERT INTO publications

(title, authors, year)

VALUES (?, ?, ?)

`,

[
